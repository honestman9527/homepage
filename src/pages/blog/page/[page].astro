---
import type { GetStaticPaths, Page as AstroPage } from "astro";
import Page from "@/components/pages/BlogPage.astro";
import { getListingPaths } from "@/lib/content";
export const getStaticPaths = (async ({ paginate }) => getListingPaths(paginate, "zh", "blog")) satisfies GetStaticPaths;
interface Props { page: AstroPage<unknown>; }
---
<Page lang="zh" currentPage={Astro.props.page.currentPage} />
