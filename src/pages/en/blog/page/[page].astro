---
import type { GetStaticPaths, Page as AstroPage } from "astro";
import Page from "@/components/astro/pages/BlogPage.astro";
import { getListingPaths } from "@/lib/content";
export const getStaticPaths = (async ({ paginate }) => getListingPaths(paginate, "en", "blog")) satisfies GetStaticPaths;
interface Props { page: AstroPage<unknown>; }
---
<Page lang="en" currentPage={Astro.props.page.currentPage} />
