---
import type { InferGetStaticPropsType } from "astro";
import BlogPostShell from "@/layouts/BlogPostShell.astro";
import { getBlogPaths } from "@/lib/content";
export async function getStaticPaths() { return getBlogPaths("en"); }
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props = Astro.props;
if (props.kind === "redirect") return Astro.redirect(props.destination, 307);
---
{props.kind === "article" && <BlogPostShell {...props} />}
