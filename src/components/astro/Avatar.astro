---
interface Props {
  fallback: string;
  src?: string;
  alt?: string;
  class?: string;
}

const { fallback, src, alt = "", class: className } = Astro.props;
---

<span
  class:list={[
    "bg-muted ring-foreground/10 relative flex shrink-0 items-center justify-center overflow-hidden rounded-full font-display font-semibold ring-1",
    className,
  ]}
>
  {src && (
    <img
      src={src}
      alt={alt}
      class="absolute inset-0 size-full object-cover"
      loading="eager"
      decoding="async"
      onerror="this.remove()"
    />
  )}
  {fallback}
</span>
