---
import "@/styles/albums.css";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import PhotoImage from "@/components/astro/albums/PhotoImage.astro";
import AlbumViewer from "@/components/astro/albums/AlbumViewer.astro";
import { routePath } from "@/config/routes";
import { photoUrl, type AlbumItem } from "@/lib/content/albums";
import { getSiteConfig } from "@/lib/site-config";
import { formatDate, uiText as t } from "@/lib/ui";

interface Props { album: AlbumItem }
const { album } = Astro.props;
const site = await getSiteConfig();
---
<SidebarLayout activeNavId="albums" title={`${album.title} — ${t("albums.title")} — ${site.name}`} description={album.description ?? t("albums.subtitle")}>
  <main class="albums-page" data-album-page>
    <header class="album-heading">
      <a class="album-back" href={routePath("albums")}>{t("albums.back")}</a>
      <h1>{album.title}</h1>
      {album.description && <p class="album-description">{album.description}</p>}
      <span class="album-count">{t("albums.count", { count: album.photos.length })}</span>
    </header>
    <div class="album-wall" data-album-wall>
      {album.photos.map((photo, index) => {
        const preview = photo.thumbnail ?? photo.src;
        return (
          <figure class="album-photo" data-album-photo data-photo-state="pending" style={typeof preview === "string" ? undefined : { "--photo-ratio": `${preview.width} / ${preview.height}` }}>
            <a class="album-photo-link" data-album-open href={photoUrl(photo.src)} target="_blank" rel="noreferrer"
              aria-label={t("albums.open", { alt: photo.alt })}
              data-photo-caption={photo.caption}
              data-photo-date={photo.takenAt ? formatDate(new Date(`${photo.takenAt}T00:00:00Z`)) : undefined}
              data-photo-location={photo.location}>
              <PhotoImage src={preview} alt={photo.alt} eager={index < 3} />
              <span class="album-photo-error" data-photo-error hidden>{t("albums.error")}</span>
            </a>
          </figure>
        );
      })}
    </div>

    <AlbumViewer />
  </main>
</SidebarLayout>
<script>
  import { onPageLifecycle } from "@/lib/page-lifecycle";
  import { mountMasonry } from "@/lib/albums/masonry";
  import { mountAlbumViewer } from "@/lib/albums/viewer";

  onPageLifecycle(() => {
    const root = document.querySelector<HTMLElement>("[data-album-page]");
    if (!root) return;
    const wall = root.querySelector<HTMLElement>("[data-album-wall]")!;
    const stopMasonry = mountMasonry(wall);
    const stopViewer = mountAlbumViewer(root);
    return () => { stopViewer(); stopMasonry(); };
  });
</script>
