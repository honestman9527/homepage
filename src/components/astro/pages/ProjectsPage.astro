---
import type { Language } from "@/i18n/ui";
import type { ProjectItem } from "@/lib/content/projects";
import { getProjectPage } from "@/lib/content/projects";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { getSiteConfig } from "@/lib/site-config";
import { getTranslations } from "@/i18n/utils";
import { resolveCover } from "@/lib/content/cover";
import { ProjectCard } from "@/components/react/content/ProjectCard";
import Cover from "@/components/astro/content/Cover.astro";
import ListingFooter from "@/components/astro/content/ListingFooter.astro";
import { ListingEmpty } from "@/components/react/content/ListingEmpty";

interface Props {
  lang: Language;
  page?: {
    items: ProjectItem[];
    currentPage: number;
    totalPages: number;
  };
}

const { lang } = Astro.props;
const page = Astro.props.page ?? (await getProjectPage(lang));
const site = await getSiteConfig();
const t = getTranslations(lang);
const suffix = page.currentPage > 1
  ? ` · ${t("pagination.page", { page: page.currentPage })}`
  : "";
---

<SidebarLayout
  activeNavId="projects"
  title={`${t("projects.title")}${suffix} — ${site.name}`}
  description={t("projects.subtitle")}
>
  <main class="listing-page">
    <header class="page-heading">
      <p>{t("projects.title")}</p>
      <h1>{t("projects.subtitle")}</h1>
    </header>
    {page.items.length ? (
      <div class="card-grid">
        {page.items.map((project, index) => {
          const cover = resolveCover(
            project.data.cover,
            site.listing.projects.defaultCover,
            site.covers.default,
          );
          return (
            <ProjectCard
              title={project.title}
              description={project.description}
              href={project.data.href}
              demoHref={project.data.demoHref}
              contentLang={project.contentLang}
              year={project.data.year}
              tags={project.data.tags}
              featured={project.data.featured}
              originalLabel={project.originalLabel}
              featuredLabel={t("projects.featured")}
              visitLabel={t("projects.visit")}
              demoLabel={t("projects.liveDemo")}
              hasCover={cover.type !== "none"}
            >
              <Cover
                slot="cover"
                cover={cover}
                contentKey={project.id}
                options={site.covers.topographic}
                aspectRatio={site.covers.aspectRatio}
                eager={index === 0}
              />
            </ProjectCard>
          );
        })}
      </div>
    ) : (
      <ListingEmpty
        title={t("empty.projects.title")}
        description={t("empty.projects.description")}
      />
    )}
    <ListingFooter
      currentPage={page.currentPage}
      totalPages={page.totalPages}
      lang={lang}
      kind="projects"
    />
  </main>
</SidebarLayout>
