---
import { getBlogItems, type BlogSearchItem } from "@/lib/content/blog";
import { tagPath } from "@/config/routes";
import { formatDate, uiText as t } from "@/lib/ui";
import { getSiteConfig } from "@/lib/site-config";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { BlogSearch } from "@/components/react/content/BlogSearch";

const site = await getSiteConfig();
const items: BlogSearchItem[] = (await getBlogItems()).map((item) => ({
  key: item.key,
  title: item.post.data.title,
  description: item.post.data.description,
  href: item.href,
  date: formatDate(item.post.data.pubDate),
  dateTime: item.post.data.pubDate.toISOString(),
  tags: item.tags.map((label) => ({ label, href: tagPath(label) })),
}));
---

<SidebarLayout
  activeNavId="blog"
  title={`${t("blog.search.title")} — ${site.name}`}
  description={t("blog.search.subtitle")}
>
  <main class="listing-page">
    <header class="page-heading">
      <p>{t("blog.title")}</p>
      <h1>{t("blog.search.subtitle")}</h1>
    </header>
    <BlogSearch
      client:load
      items={items}
      readLabel={t("blog.readPost")}
      labels={{
        input: t("blog.search.label"),
        placeholder: t("blog.search.placeholder"),
        results: t("blog.search.results", { count: "{count}" }),
        initialTitle: t("blog.search.empty.title"),
        initialDescription: t("blog.search.empty.description"),
        emptyTitle: t("blog.search.none.title"),
        emptyDescription: t("blog.search.none.description"),
      }}
    />
  </main>
</SidebarLayout>
