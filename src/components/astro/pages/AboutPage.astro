---
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import Avatar from "@/components/astro/Avatar.astro";
import { Badge } from "@/components/react/ui/badge";
import { getTranslations } from "@/i18n/utils";
import type { Language } from "@/i18n/ui";
import { getSiteConfig } from "@/lib/site-config";
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = getTranslations(lang);
const site = await getSiteConfig();
---
<SidebarLayout activeNavId="about" title={`${t("about.title")} — ${site.name}`} description={t("about.subtitle")}>
  <section class="listing-page">
    <header class="page-heading"><p>{t("about.title")}</p><h1>{t("about.subtitle")}</h1></header>
    <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
      <Avatar fallback={site.initials} src={site.avatar} alt={site.name} class="size-24 text-2xl" />
      <div class="flex max-w-2xl flex-col gap-4 text-lg text-pretty">{site.profile[lang].about.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
    <div class="mt-14"><h2 class="text-muted-foreground mb-3 font-mono text-xs tracking-widest uppercase">{t("about.toolbox")}</h2>
      <div class="flex flex-wrap gap-1.5">{site.skills.map((skill) => <Badge variant="secondary">{skill}</Badge>)}</div>
    </div>
  </section>
</SidebarLayout>
