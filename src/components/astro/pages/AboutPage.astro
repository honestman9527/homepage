---
import { uiText as t } from "@/lib/ui";
import { getAboutConfig, getSiteConfig } from "@/lib/site-config";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import Avatar from "@/components/astro/Avatar.astro";
import { ProfileSummary } from "@/components/react/profile/ProfileSummary";
import { SkillList } from "@/components/react/profile/SkillList";


const site = await getSiteConfig();
const about = await getAboutConfig();
const profile = site.profile;
---

<SidebarLayout
  activeNavId="about"
  title={`${about.title} — ${site.name}`}
  description={about.description}
>
  <main class="about-page">
    <ProfileSummary
      name={site.name}
      heading={about.title}
      bio={profile.bio}
      location={profile.location}
      availability={profile.availability}
      headingLevel={1}
    >
      <Avatar
        slot="avatar"
        fallback={site.initials}
        src={site.avatar}
        alt={site.name}
        class="size-24 text-2xl"
      />
    </ProfileSummary>

    <div class="about-sections">
      {about.sections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
    </div>

    <section class="about-toolbox" aria-labelledby="about-toolbox">
      <h2
        id="about-toolbox"
        class="text-muted-foreground mb-3 font-mono text-xs tracking-widest uppercase"
      >
        {t("about.toolbox")}
      </h2>
      <SkillList skills={site.skills} label={t("about.toolbox")} />
    </section>
  </main>
</SidebarLayout>
