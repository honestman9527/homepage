---
import type { BlogItem } from "@/lib/content/blog";
import { tagListingPath } from "@/config/routes";
import { uiText as t } from "@/lib/ui";
import { getSiteConfig } from "@/lib/site-config";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import BlogList from "@/components/astro/blog/BlogList.astro";
import ListingFooter from "@/components/astro/content/ListingFooter.astro";

interface Props {
  tag: string;
  page: { items: BlogItem[]; currentPage: number; totalPages: number };
}

const { tag, page } = Astro.props;
const site = await getSiteConfig();
const suffix = page.currentPage > 1
  ? ` · ${t("pagination.page", { page: page.currentPage })}`
  : "";
const hrefs = Array.from(
  { length: page.totalPages },
  (_, index) => tagListingPath(tag, index + 1),
);
---

<SidebarLayout
  activeNavId="blog"
  title={`${tag}${suffix} — ${site.name}`}
  description={t("blog.tag.subtitle", { tag })}
>
  <main class="listing-page">
    <header class="page-heading">
      <p>{t("blog.tags.title")}</p>
      <h1>{t("blog.tag.subtitle", { tag })}</h1>
    </header>
    <BlogList items={page.items} />
    <ListingFooter
      currentPage={page.currentPage}
      totalPages={page.totalPages}
      hrefs={hrefs}
    />
  </main>
</SidebarLayout>
