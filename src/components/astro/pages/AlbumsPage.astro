---
import "@/styles/albums.css";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import AlbumCard from "@/components/astro/albums/AlbumCard.astro";
import { ListingEmpty } from "@/components/react/content/ListingEmpty";
import { getAlbumItems } from "@/lib/content/albums";
import { getSiteConfig } from "@/lib/site-config";
import { uiText as t } from "@/lib/ui";

const [albums, site] = await Promise.all([getAlbumItems(), getSiteConfig()]);
---
<SidebarLayout activeNavId="albums" title={`${t("albums.title")} — ${site.name}`} description={t("albums.subtitle")}>
  <main class="albums-page">
    <header class="album-heading">
      <h1>{t("albums.title")}</h1>
      <p class="album-description">{t("albums.subtitle")}</p>
    </header>
    {albums.length ? (
      <div class="album-grid">
        {albums.map((album, index) => <AlbumCard album={album} eager={index === 0} />)}
      </div>
    ) : <ListingEmpty className="album-empty" title={t("empty.albums.title")} description={t("empty.albums.description")} />}
  </main>
</SidebarLayout>
