---
import { GithubLogoIcon, LinkedinLogoIcon, XLogoIcon, EnvelopeSimpleIcon, GlobeIcon } from "@phosphor-icons/react";
import type { SiteConfig } from "@/lib/site-config";
type SocialLink = SiteConfig["social"][number];
interface Props { email: string; social: SocialLink[]; emailLabel: string; }
const { email, social, emailLabel } = Astro.props;
const icons = { github: GithubLogoIcon, linkedin: LinkedinLogoIcon, x: XLogoIcon, website: GlobeIcon };
---
<div class="flex items-center gap-1">
  {social.map((link) => { const Icon = icons[link.type]; return <a href={link.url} target="_blank" rel="noreferrer" aria-label={link.label} class="social-link"><Icon size={18} /></a>; })}
  <a href={`mailto:${email}`} aria-label={emailLabel} class="social-link"><EnvelopeSimpleIcon size={18} /></a>
</div>
