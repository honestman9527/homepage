---
import { Pagination } from "@/components/react/content/Pagination";
import { listingPath } from "@/config/routes";
import { uiText as t } from "@/lib/ui";
interface Props {
  currentPage: number;
  totalPages: number;
  kind?: "blog" | "projects";
  hrefs?: string[];
}
const { currentPage, totalPages, kind, hrefs: customHrefs } = Astro.props;
if (!kind && !customHrefs) throw new Error("Pagination requires a kind or hrefs");
const hrefs = customHrefs ?? Array.from(
  { length: totalPages },
  (_, i) => listingPath(kind!, i + 1),
);
---
<Pagination currentPage={currentPage} totalPages={totalPages} hrefs={hrefs} labels={{ navigation: t("pagination.label"), previous: t("pagination.previous"), next: t("pagination.next"), more: t("pagination.more"), pages: hrefs.map((_, i) => t("pagination.page", { page: i + 1 })), summary: t("pagination.summary", { page: currentPage, total: totalPages }) }} />
