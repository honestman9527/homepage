---
import type { BlogItem } from "@/lib/content/blog";
import { tagPath } from "@/config/routes";
import { formatDate, uiText as t } from "@/lib/ui";
import { getSiteConfig } from "@/lib/site-config";
import { resolveCover } from "@/lib/content/cover";
import { BlogCard } from "@/components/react/content/BlogCard";
import { ListingEmpty } from "@/components/react/content/ListingEmpty";
import Cover from "@/components/astro/content/Cover.astro";

interface Props {
  items: BlogItem[];
  emptyTitle?: string;
  emptyDescription?: string;
}

const { items, emptyTitle, emptyDescription } = Astro.props;
const site = await getSiteConfig();
---

{items.length ? (
  <div class="card-grid">
    {items.map(({ post, href, key, tags }, index) => {
      const cover = resolveCover(
        post.data.cover,
        site.listing.blog.defaultCover,
        site.covers.default,
      );
      return (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          href={href}
          date={formatDate(post.data.pubDate)}
          dateTime={post.data.pubDate.toISOString()}
          tags={tags}
          tagHrefs={tags.map((tag) => tagPath(tag))}
          readLabel={t("blog.readPost")}
          hasCover={cover.type !== "none"}
        >
          <Cover
            slot="cover"
            cover={cover}
            contentKey={key}
            options={site.covers.topographic}
            aspectRatio={site.covers.aspectRatio}
            href={href}
            label={post.data.title}
            eager={index === 0}
          />
        </BlogCard>
      );
    })}
  </div>
) : (
  <ListingEmpty
    title={emptyTitle ?? t("empty.blog.title")}
    description={emptyDescription ?? t("empty.blog.description")}
  />
)}
