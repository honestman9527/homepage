---
import type { MarkdownHeading } from "astro";
import ArticleExperience from "./ArticleExperience.astro";
import TableOfContents from "./TableOfContents.astro";

interface Props {
  headings: MarkdownHeading[];
  toc?: boolean;
  tocLabel: string;
  showProgress?: boolean;
}

const {
  headings,
  toc = true,
  tocLabel,
  showProgress = false,
} = Astro.props;
const tocHeadings = toc
  ? headings.filter(
      ({ depth, slug }) =>
        (depth === 2 || depth === 3) && slug !== "footnote-label",
    )
  : [];
const hasCover = Astro.slots.has("cover");
const hasAfterword = Astro.slots.has("afterword");
---

<div class="post-page">
  <ArticleExperience showProgress={showProgress} />
  <div class="post-layout">
    <div class="post-column">
      <article data-reading-region>
        <slot name="header" />
        {tocHeadings.length > 0 && (
          <TableOfContents headings={tocHeadings} label={tocLabel} variant="mobile" />
        )}
        {hasCover && <div class="post-cover"><slot name="cover" /></div>}
        <div class="prose-blog" data-article-content><slot /></div>
      </article>
      {hasAfterword && <slot name="afterword" />}
    </div>
    {tocHeadings.length > 0 && (
      <aside class="post-toc-rail">
        <TableOfContents headings={tocHeadings} label={tocLabel} variant="desktop" />
      </aside>
    )}
  </div>
</div>
