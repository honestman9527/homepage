---
import { GithubLogoIcon, LinkedinLogoIcon, XLogoIcon, EnvelopeSimpleIcon } from "@phosphor-icons/react";
import { getSiteConfig } from "@/lib/site-config";

interface Props {
  email: string;
}

const { email } = Astro.props;

const site = await getSiteConfig();
const social = site.social;

const socialIcons: Record<string, typeof GithubLogoIcon> = {
  GitHub: GithubLogoIcon,
  LinkedIn: LinkedinLogoIcon,
  X: XLogoIcon,
};
---

<div class="flex items-center gap-1">
  {social.map((socialLink) => (
    <a
      href={socialLink.url}
      target="_blank"
      rel="noreferrer"
      aria-label={socialLink.label}
      class="text-muted-foreground hover:bg-muted hover:text-foreground flex size-8 items-center justify-center rounded-lg transition-colors"
    >
      {socialIcons[socialLink.label] ? (
        <socialIcons[socialLink.label] size={16} />
      ) : (
        <span class="text-xs font-medium">{socialLink.label.slice(0, 2)}</span>
      )}
    </a>
  ))}
  <a
    href={`mailto:${email}`}
    aria-label="Email"
    class="text-muted-foreground hover:bg-muted hover:text-foreground flex size-8 items-center justify-center rounded-lg transition-colors"
  >
    <EnvelopeSimpleIcon size={16} />
  </a>
</div>
