---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { applyTheme, readTheme } from "@/lib/theme";
import {
  applyInitialSidebarPreference,
  readSidebarPreference,
} from "@/lib/sidebar-preference";
import type { SiteConfig } from "@/lib/site-config";
interface Props {
  title: string; description: string; skipLabel: string;
  favicon: SiteConfig["favicon"];
  article?: { published: Date; updated?: Date };
  musicEnabled?: boolean;
}
const { title, description, skipLabel, favicon, article, musicEnabled = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site);
const themeScript = `(${applyTheme.toString()})((${readTheme.toString()})().theme);`;
const sidebarScript = `(${applyInitialSidebarPreference.toString()})(${readSidebarPreference.toString()});`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon.light} data-theme-favicon data-light={favicon.light} data-dark={favicon.dark} />
    <script is:inline set:html={themeScript} />
    <script is:inline set:html={sidebarScript} />
    <title>{title}</title>
    {musicEnabled && <ClientRouter />}
    <script>
      import { applyTheme, readTheme } from "@/lib/theme";
      import { applyInitialSidebarPreference, readSidebarPreference } from "@/lib/sidebar-preference";
      document.addEventListener("astro:after-swap", () => {
        applyTheme(readTheme().theme);
        applyInitialSidebarPreference(readSidebarPreference);
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    {musicEnabled && <audio data-music-audio transition:persist="site-music" preload="none" hidden />}
    <slot />
  </body>
</html>
