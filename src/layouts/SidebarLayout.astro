---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AppShell } from "@/components/layout/AppShell";
import { getLangFromUrl, translatePath, useTranslations } from "@/i18n/utils";
import { getSiteConfig } from "@/lib/site-config";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description,
  currentPath = "/",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = await getSiteConfig();

const siteTitleSuffix = {
  zh: "主页",
  en: "Homepage",
} as const;

const pageTitle = title ?? `${site.name} — ${siteTitleSuffix[lang]}`;
const pageDescription = description ?? t("site.description");

const nav = (["home", "projects", "blog", "about"] as const).map((key) => ({
  label: t(`nav.${key}` as const),
  href: translatePath(lang, key === "home" ? "/" : `/${key}`),
}));

const localizedPath =
  currentPath === "/" || currentPath === "/en/"
    ? lang === "zh"
      ? "/"
      : "/en/"
    : currentPath;
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
  <AppShell
    client:load
    currentPath={localizedPath}
    currentLang={lang}
    nav={nav}
    elsewhereLabel={t("sidebar.elsewhere")}
    brandName={site.name}
    brandDomain={site.domain}
    socialLinks={site.social}
  >
    <slot />
  </AppShell>
</BaseLayout>
