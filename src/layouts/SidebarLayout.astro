---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AppShell } from "@/components/react/layout/AppShell";
import { uiText as t } from "@/lib/ui";
import {
  getBlogSectionFromPath,
  listingPath,
  routePath,
  searchPath,
  tagsPath,
} from "@/config/routes";
import { getMusicConfig, getSiteConfig } from "@/lib/site-config";
import type { NavId } from "@/config/routes";
import type { AppShellViewModel } from "@/components/react/layout/types";
interface Props {
  title?: string; description?: string; activeNavId: NavId;
  article?: { published: Date; updated?: Date };
}
const { title, description, activeNavId, article } = Astro.props;
const [site, music] = await Promise.all([getSiteConfig(), getMusicConfig()]);
const activeBlogSection = getBlogSectionFromPath(Astro.url.pathname);
const blogNavigation = [
  { id: "posts", label: t("blog.nav.posts"), href: listingPath("blog") },
  { id: "tags", label: t("blog.nav.tags"), href: tagsPath() },
  { id: "search", label: t("blog.nav.search"), href: searchPath() },
].map((item) => ({
  ...item,
  isActive: activeNavId === "blog" && item.id === activeBlogSection,
}));
const navigation = site.navigation.map((id) => ({
  id,
  label: t(`nav.${id}`),
  href: routePath(id),
  toggleLabel: id === "blog" ? t("blog.nav.toggle") : undefined,
  children: id === "blog" ? blogNavigation : undefined,
}));
const year = new Date().getUTCFullYear();
const viewModel = {
  header: {
    title: t(`nav.${activeNavId}`),
    sticky: site.layout.header.sticky,
    sidebarToggleLabel: t("sidebar.toggle"),
    music: music.enabled ? music.tracks : undefined,
  },
  sidebar: {
    activeNavId,
    navigation,
    labels: {
      toggle: t("sidebar.toggle"),
      title: t("sidebar.title"),
      description: t("sidebar.description"),
      close: t("sidebar.close"),
    },
    brand: {
      name: site.name,
      domain: Astro.site!.hostname,
      homeHref: routePath("home"),
      logo: site.favicon,
    },
    footer: {
      profile: {
        name: site.name,
        email: site.email,
        avatar: site.avatar,
        initials: site.initials,
      },
      copyright: `© ${year}`,
      themeLabels: {
        toggle: t("theme.toggle"),
        light: t("theme.light"),
        dark: t("theme.dark"),
        system: t("theme.system"),
      },
    },
  },
} satisfies AppShellViewModel;
---
<BaseLayout title={title ?? `${site.name} — ${t("site.title")}`} description={description ?? t("site.description")} skipLabel={t("common.skip")} favicon={site.favicon} article={article} musicEnabled={music.enabled}>
  <AppShell client:load viewModel={viewModel}>
    <slot />
  </AppShell>
</BaseLayout>
