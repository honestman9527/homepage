---
import { render } from "astro:content";
import type { BlogEntry } from "@/lib/content/model";
import type { ArticleNavigation } from "@/lib/content";
import type { LanguageLink } from "@/i18n/types";
import type { Language } from "@/i18n/ui";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { ArticleHeader } from "@/components/react/content/ArticleHeader";
import Cover from "@/components/astro/content/Cover.astro";
import MarkdownDocument from "@/components/astro/content/MarkdownDocument.astro";
import ArticleAfterword from "@/components/astro/blog/ArticleAfterword.astro";
import { resolveCover } from "@/lib/content/cover";
import { estimateReadingMinutes } from "@/lib/content/model";
import { getSiteConfig } from "@/lib/site-config";
import { commentPath } from "@/lib/comments/path";
import { resolveCommentsConfig } from "@/lib/comments/config";
import { formatDate, getTranslations } from "@/i18n/utils";

interface Props {
  post: BlogEntry;
  original: BlogEntry;
  lang: Language;
  languageLink: LanguageLink;
  alternates: { lang: Language; href: string }[];
  navigation: ArticleNavigation;
}

const { post, original, lang, languageLink, alternates, navigation } =
  Astro.props;
const { Content, headings } = await render(post);
const site = await getSiteConfig();
const t = getTranslations(lang);
const cover = resolveCover(
  post.data.cover,
  original.data.cover,
  site.listing.blog.defaultCover,
  site.covers.default,
);
const readingMinutes = estimateReadingMinutes(post.body ?? "");
const commentsConfig = resolveCommentsConfig(site.comments, post.data.comments);
---

<SidebarLayout
  activeNavId="blog"
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  languageLink={languageLink}
  alternates={alternates}
  article={{
    published: original.data.pubDate,
    updated: post.data.updatedDate,
  }}
>
  <MarkdownDocument
    headings={headings}
    lang={post.data.lang}
    toc={post.data.toc}
    tocLabel={t("blog.toc")}
    showProgress
  >
    <ArticleHeader
      slot="header"
      lang={post.data.lang}
      title={post.data.title}
      description={post.data.description}
      tags={post.data.tags}
      published={{
        label: formatDate(original.data.pubDate, lang),
        dateTime: original.data.pubDate.toISOString(),
      }}
      readingTime={t("blog.readingTime", { minutes: readingMinutes })}
      updated={post.data.updatedDate
        ? {
            prefix: t("common.updated"),
            label: formatDate(post.data.updatedDate, lang),
            dateTime: post.data.updatedDate.toISOString(),
          }
        : undefined}
    />

    <Cover
      slot="cover"
      cover={cover}
      contentKey={post.data.translationKey}
      options={site.covers.topographic}
      aspectRatio={site.covers.aspectRatio}
      eager
    />

    <Content />

    <ArticleAfterword
      slot="afterword"
      navigation={navigation}
      commentsConfig={commentsConfig}
      commentsPath={commentPath(post.data.translationKey)}
      lang={post.data.lang}
      labels={{
        older: t("blog.olderPost"),
        newer: t("blog.newerPost"),
        comments: {
          title: t("comments.title"),
          eyebrow: t("comments.eyebrow"),
          loading: t("comments.loading"),
          error: t("comments.error"),
          retry: t("comments.retry"),
          noScript: t("comments.noScript"),
        },
      }}
    />
  </MarkdownDocument>
</SidebarLayout>
