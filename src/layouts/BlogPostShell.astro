---
import { render } from "astro:content";
import type { BlogEntry, ArticleNavigation } from "@/lib/content/blog";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { ArticleHeader } from "@/components/react/content/ArticleHeader";
import Cover from "@/components/astro/content/Cover.astro";
import MarkdownDocument from "@/components/astro/blog/MarkdownDocument.astro";
import ArticleAfterword from "@/components/astro/blog/ArticleAfterword.astro";
import { resolveCover } from "@/lib/content/cover";
import { estimateReadingMinutes } from "@/lib/content/reading";
import { normalizeTags } from "@/lib/content/blog";
import { tagPath } from "@/config/routes";
import { getSiteConfig } from "@/lib/site-config";
import { commentPath, resolveCommentsConfig } from "@/lib/comments/runtime";
import { formatDate, uiText as t } from "@/lib/ui";

interface Props {
  post: BlogEntry;
  navigation: ArticleNavigation;
}

const { post, navigation } = Astro.props;
const { Content, headings } = await render(post);
const site = await getSiteConfig();
const cover = resolveCover(
  post.data.cover,
  site.listing.blog.defaultCover,
  site.covers.default,
);
const readingMinutes = estimateReadingMinutes(post.body ?? "");
const commentsConfig = resolveCommentsConfig(site.comments, post.data.comments);
const tags = normalizeTags(post.data.tags);
---

<SidebarLayout
  activeNavId="blog"
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  article={{
    published: post.data.pubDate,
    updated: post.data.updatedDate,
  }}
>
  <MarkdownDocument
    headings={headings}
    toc={post.data.toc}
    tocLabel={t("blog.toc")}
    showProgress
  >
    <ArticleHeader
      slot="header"
      title={post.data.title}
      description={post.data.description}
      tags={tags}
      tagHrefs={tags.map((tag) => tagPath(tag))}
      published={{
        label: formatDate(post.data.pubDate),
        dateTime: post.data.pubDate.toISOString(),
      }}
      readingTime={t("blog.readingTime", { minutes: readingMinutes })}
      updated={post.data.updatedDate
        ? {
            prefix: t("common.updated"),
            label: formatDate(post.data.updatedDate),
            dateTime: post.data.updatedDate.toISOString(),
          }
        : undefined}
    />

    <Cover
      slot="cover"
      cover={cover}
      contentKey={post.data.slug}
      options={site.covers.topographic}
      aspectRatio={site.covers.aspectRatio}
      eager
    />

    <Content />

    <ArticleAfterword
      slot="afterword"
      navigation={navigation}
      commentsConfig={commentsConfig}
      commentsPath={commentPath(post.data.slug)}
      labels={{
        older: t("blog.olderPost"),
        newer: t("blog.newerPost"),
        comments: {
          title: t("comments.title"),
          eyebrow: t("comments.eyebrow"),
          loading: t("comments.loading"),
          error: t("comments.error"),
          retry: t("comments.retry"),
          noScript: t("comments.noScript"),
        },
      }}
    />
  </MarkdownDocument>
</SidebarLayout>
