---
import { render } from "astro:content";
import type { BlogEntry } from "@/lib/content/model";
import type { ArticleNavigation, LanguageLink } from "@/lib/content";
import type { Language } from "@/i18n/ui";
import SidebarLayout from "@/layouts/SidebarLayout.astro";
import { Badge } from "@/components/react/ui/badge";
import { Separator } from "@/components/react/ui/separator";
import { ArticleNavigation as ArticleNavigationView } from "@/components/react/content/ArticleNavigation";
import Cover from "@/components/astro/content/Cover.astro";
import ArticleExperience from "@/components/astro/blog/ArticleExperience.astro";
import Comments from "@/components/astro/blog/Comments.astro";
import TableOfContents from "@/components/astro/blog/TableOfContents.astro";
import { resolveCover } from "@/lib/content/cover";
import { estimateReadingMinutes } from "@/lib/content/model";
import { getSiteConfig } from "@/lib/site-config";
import { commentPath } from "@/lib/comments/path";
import { resolveCommentsConfig } from "@/lib/comments/config";
import { formatDate, getTranslations } from "@/i18n/utils";

interface Props {
  post: BlogEntry;
  original: BlogEntry;
  lang: Language;
  languageLink: LanguageLink;
  alternates: { lang: Language; href: string }[];
  navigation: ArticleNavigation;
}

const { post, original, lang, languageLink, alternates, navigation } =
  Astro.props;
const { Content, headings } = await render(post);
const site = await getSiteConfig();
const t = getTranslations(lang);
const cover = resolveCover(
  post.data.cover,
  original.data.cover,
  site.listing.blog.defaultCover,
  site.covers.default,
);
const tocHeadings = post.data.toc
  ? headings.filter(({ depth }) => depth === 2 || depth === 3)
  : [];
const readingMinutes = estimateReadingMinutes(post.body ?? "");
const commentsConfig = resolveCommentsConfig(site.comments, post.data.comments);
const hasNavigation = Boolean(navigation.older || navigation.newer);
---

<SidebarLayout
  activeNavId="blog"
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  languageLink={languageLink}
  alternates={alternates}
  article={{
    published: original.data.pubDate,
    updated: post.data.updatedDate,
  }}
>
  <div class="post-page">
    <ArticleExperience />
    <div class="post-layout">
      <div class="post-column">
        <article lang={post.data.lang} data-reading-region>
          <header class="post-header">
            <div class="post-meta">
              <time datetime={original.data.pubDate.toISOString()}>
                {formatDate(original.data.pubDate, lang)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{t("blog.readingTime", { minutes: readingMinutes })}</span>
              {
                post.data.updatedDate && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      {t("common.updated")} {" "}
                      <time datetime={post.data.updatedDate.toISOString()}>
                        {formatDate(post.data.updatedDate, lang)}
                      </time>
                    </span>
                  </>
                )
              }
            </div>
            <h1>{post.data.title}</h1>
            <p class="post-description">{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
            </div>
          </header>

          {
            tocHeadings.length > 0 && (
              <TableOfContents
                headings={tocHeadings}
                label={t("blog.toc")}
                variant="mobile"
              />
            )
          }

          <div class="post-cover">
            <Cover
              cover={cover}
              contentKey={post.data.translationKey}
              options={site.covers.topographic}
              aspectRatio={site.covers.aspectRatio}
              eager
            />
          </div>
          <div class="prose-blog" data-article-content><Content /></div>
        </article>

        {
          hasNavigation && (
            <div class="post-afterword">
              <Separator />
              <ArticleNavigationView
                navigation={navigation}
                labels={{
                  older: t("blog.olderPost"),
                  newer: t("blog.newerPost"),
                }}
              />
            </div>
          )
        }

        {
          commentsConfig && (
            <div class="post-comments">
              <Separator />
              <Comments
                config={commentsConfig}
                path={commentPath(post.data.translationKey)}
                lang={lang}
                labels={{
                  title: t("comments.title"),
                  loading: t("comments.loading"),
                  error: t("comments.error"),
                  retry: t("comments.retry"),
                  noScript: t("comments.noScript"),
                }}
              />
            </div>
          )
        }
      </div>

      {
        tocHeadings.length > 0 && (
          <aside class="post-toc-rail">
            <TableOfContents
              headings={tocHeadings}
              label={t("blog.toc")}
              variant="desktop"
            />
          </aside>
        )
      }
    </div>
  </div>
</SidebarLayout>
