{
  "name": "honestos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run src build",
    "test:preview": "node build/check-preview.ts",
    "check": "pnpm typecheck && pnpm test:core && pnpm build && pnpm test:preview",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "verify": "node build/verification.ts",
    "lint": "node build/verification.ts --lint",
    "hooks:install": "node build/verification.ts --install-hooks"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@cloudflare/vite-plugin": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "catalog:"
  }
}
